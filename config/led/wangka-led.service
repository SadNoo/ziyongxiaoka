[Unit]
Description=UFI103S RGB status LED controller
After=local-fs.target wangka-network-ready.service vohive.service
Wants=wangka-network-ready.service vohive.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/wangka-led watch
Restart=always
RestartSec=2s
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/wangka-management /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
