[Unit]
Description=VoHive port-free local management sockets
# FreeBind lets these fixed private listeners start before their addresses are
# configured.  Do not order a socket unit after NetworkManager: socket units
# are implicitly before sockets.target and that would create a boot cycle.

[Socket]
ListenStream=192.168.4.1:80
ListenStream=192.168.5.1:80
ListenStream=192.168.4.1:7575
ListenStream=192.168.5.1:7575
FreeBind=yes
NoDelay=yes

[Install]
WantedBy=multi-user.target
