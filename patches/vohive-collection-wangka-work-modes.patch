diff --git a/vohive/internal/workmode/work_mode.go b/vohive/internal/workmode/work_mode.go
new file mode 100644
index 0000000..f42af21
--- /dev/null
+++ b/vohive/internal/workmode/work_mode.go
@@ -0,0 +1,38 @@
+package workmode
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+)
+
+const defaultManagementState = "/var/lib/wangka-management/state.json"
+
+// SMSEnabled reports whether the appliance work mode allows the SMS engine to
+// run. Missing or malformed state deliberately fails open so stock VoHive
+// installations keep their original behaviour.
+func SMSEnabled() bool {
+	path := strings.TrimSpace(os.Getenv("WANGKA_MANAGEMENT_STATE"))
+	if path == "" {
+		path = defaultManagementState
+	}
+
+	file, err := os.Open(path)
+	if err != nil {
+		return true
+	}
+	defer file.Close()
+
+	raw, err := io.ReadAll(io.LimitReader(file, 64*1024+1))
+	if err != nil || len(raw) > 64*1024 {
+		return true
+	}
+	var state struct {
+		WorkMode string `json:"work_mode"`
+	}
+	if err := json.Unmarshal(raw, &state); err != nil {
+		return true
+	}
+	return strings.ToLower(strings.TrimSpace(state.WorkMode)) != "data"
+}
diff --git a/vohive/internal/workmode/work_mode_test.go b/vohive/internal/workmode/work_mode_test.go
new file mode 100644
index 0000000..8b9f7c9
--- /dev/null
+++ b/vohive/internal/workmode/work_mode_test.go
@@ -0,0 +1,38 @@
+package workmode
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSMSEnabledDefaultsToEnabled(t *testing.T) {
+	t.Setenv("WANGKA_MANAGEMENT_STATE", filepath.Join(t.TempDir(), "missing.json"))
+	if !SMSEnabled() {
+		t.Fatal("missing appliance state must preserve stock SMS behaviour")
+	}
+}
+
+func TestSMSEnabledReadsWorkMode(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	t.Setenv("WANGKA_MANAGEMENT_STATE", path)
+	for _, tc := range []struct {
+		name    string
+		content string
+		want    bool
+	}{
+		{name: "dual", content: `{"work_mode":"dual"}`, want: true},
+		{name: "sms", content: `{"work_mode":"sms"}`, want: true},
+		{name: "data", content: `{"work_mode":"data"}`, want: false},
+		{name: "invalid", content: `{`, want: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := os.WriteFile(path, []byte(tc.content), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if got := SMSEnabled(); got != tc.want {
+				t.Fatalf("SMSEnabled() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
