#!/usr/bin/expect -f

set timeout 45
log_user 0

foreach name {WANGKA_USER_PASSWORD WANGKA_NEW_PASSWORD} {
    if {![info exists env($name)]} {
        puts stderr "$name is not set"
        exit 2
    }
}

set old_password $env(WANGKA_USER_PASSWORD)
set new_password $env(WANGKA_NEW_PASSWORD)

spawn ssh -tt \
    -b 192.168.5.242 \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=/private/tmp/wangka-known-hosts \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    user@192.168.5.1 \
    {sudo -k; sudo -p "__SUDO_PASSWORD__" passwd user}

set updated 0
expect {
    -re {user@192\.168\.5\.1.*password:} {
        send -- "$old_password\r"
        exp_continue
    }
    "__SUDO_PASSWORD__" {
        send -- "$old_password\r"
        exp_continue
    }
    "New password:" {
        send -- "$new_password\r"
        exp_continue
    }
    "Retype new password:" {
        send -- "$new_password\r"
        exp_continue
    }
    -re {password updated successfully} {
        set updated 1
        exp_continue
    }
    timeout {
        puts stderr "password rotation timed out"
        exit 124
    }
    eof
}

catch wait result
set exit_code [lindex $result 3]
if {$exit_code != 0 || !$updated} {
    puts stderr "password rotation failed"
    exit 1
}
puts "DEVICE_PASSWORD_ROTATED=YES"
