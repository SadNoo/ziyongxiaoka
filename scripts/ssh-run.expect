#!/usr/bin/expect -f

set timeout 240

if {![info exists env(WANGKA_USER_PASSWORD)]} {
    puts stderr "WANGKA_USER_PASSWORD is not set"
    exit 2
}

if {$argc != 1} {
    puts stderr "usage: ssh-run.expect <remote-command>"
    exit 2
}

set remote_command [lindex $argv 0]
set known_hosts "/private/tmp/wangka-known-hosts"
set host "192.168.5.1"
set bind_address "192.168.5.242"
if {[info exists env(WANGKA_SSH_HOST)]} {
    set host $env(WANGKA_SSH_HOST)
}
if {[info exists env(WANGKA_SSH_BIND_ADDRESS)]} {
    set bind_address $env(WANGKA_SSH_BIND_ADDRESS)
}

set ssh_args [list \
    -tt \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=$known_hosts \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no]
if {$bind_address ne ""} {
    lappend ssh_args -b $bind_address
}
lappend ssh_args user@$host $remote_command

spawn ssh {*}$ssh_args

set password_prompts 0
expect {
    -re {password:} {
        incr password_prompts
        if {$password_prompts > 3} {
            puts stderr "too many password prompts"
            exit 3
        }
        send -- "$env(WANGKA_USER_PASSWORD)\r"
        exp_continue
    }
    -re {password for [^:]+:} {
        incr password_prompts
        if {$password_prompts > 3} {
            puts stderr "too many password prompts"
            exit 3
        }
        send -- "$env(WANGKA_USER_PASSWORD)\r"
        exp_continue
    }
    timeout {
        puts stderr "SSH timed out"
        exit 4
    }
    eof
}

set wait_result [wait]
exit [lindex $wait_result 3]
